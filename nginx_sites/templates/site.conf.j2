{% if nginx_redirect_http | default(true) %}
server {
    listen 80;
    server_name {{ item.server_name }};

    server_tokens off;

    access_log /var/log/nginx/access.log;
    error_log  /var/log/nginx/error.log warn;

    # Allow Let's Encrypt HTTP-01 challenges.
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    # Redirect all normal HTTP traffic to HTTPS.
    location / {
        return 301 https://$host$request_uri;
    }
}
{% endif %}

{% if nginx_tls_enabled | default(true) %}
server {
    listen 443 ssl;
    http2 on;

    server_name {{ item.server_name }};

    server_tokens off;

    charset utf-8;

    client_max_body_size {{ item.client_max_body_size | default('50M') }};

    access_log /var/log/nginx/access.log;
    error_log  /var/log/nginx/error.log warn;

    ssl_certificate     {{ nginx_tls_certificate }};
    ssl_certificate_key {{ nginx_tls_certificate_key }};

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    {% if item.root is defined %}
    root {{ item.root }};
    {% endif %}

    {% for loc in item.locations %}
    location {{ loc.path }} {
{{ loc.content | indent(8, true) }}
    }
    {% endfor %}

    location = /favicon.ico {
        log_not_found off;
        access_log off;
    }

    location = /robots.txt {
        allow all;
        log_not_found off;
        access_log off;
    }
}
{% endif %}

