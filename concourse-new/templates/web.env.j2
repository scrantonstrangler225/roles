
CONCOURSE_POSTGRES_HOST=concourse-db
CONCOURSE_POSTGRES_USER={{ concourse_postgres_user }}
CONCOURSE_POSTGRES_PASSWORD={{ concourse_postgres_password }}
CONCOURSE_POSTGRES_DATABASE={{ concourse_postgres_db }}

CONCOURSE_EXTERNAL_URL={{ concourse_external_url }}

CONCOURSE_ADD_LOCAL_USER={{ concourse_local_user }}:{{ concourse_local_password }}
CONCOURSE_MAIN_TEAM_LOCAL_USER={{ concourse_local_user }}

# Vault integration
CONCOURSE_SECRET_MANAGER=vault
CONCOURSE_VAULT_URL={{ vault_addr }}
CONCOURSE_VAULT_AUTH_BACKEND=approle
CONCOURSE_VAULT_PATH_PREFIX={{ concourse_vault_path }}
CONCOURSE_VAULT_AUTH_PARAM="role_id:{{ vault_role_id }},secret_id:{{ vault_secret_id }}"
CONCOURSE_VAULT_LOOKUP_TEMPLATES=/concourse/{{ '{{.Secret}}' }}

# Concourse security
CONCOURSE_CLIENT_SECRET={{ concourse_client_secret }}
CONCOURSE_TSA_CLIENT_SECRET={{ concourse_tsa_client_secret }}
CONCOURSE_SESSION_SIGNING_KEY=/concourse-keys/session_signing_key

# Cluster
CONCOURSE_CLUSTER_NAME={{ concourse_cluster_name }}

# TSA
CONCOURSE_TSA_HOST_KEY=/concourse-keys/tsa_host_key
CONCOURSE_TSA_AUTHORIZED_KEYS=/concourse-keys/authorized_worker_keys.pub

# Features
CONCOURSE_ENABLE_PIPELINE_INSTANCES={{ concourse_enable_pipeline_instances | lower }}
CONCOURSE_ENABLE_ACROSS_STEP={{ concourse_enable_across_step | lower }}
CONCOURSE_ENABLE_RESOURCE_CAUSALITY={{ concourse_enable_resource_causality | lower }}

