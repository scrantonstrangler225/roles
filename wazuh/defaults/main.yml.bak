---
# -------------------------------------------------------------------
# General
# -------------------------------------------------------------------

wazuh_version: "4.14.0"

wazuh_project_name: wazuh

wazuh_base_dir: "/opt/wazuh"

wazuh_config_dir: "{{ wazuh_base_dir }}/config"
wazuh_data_dir: "{{ wazuh_base_dir }}/data"
wazuh_logs_dir: "{{ wazuh_base_dir }}/logs"
wazuh_certs_dir: "{{ wazuh_base_dir }}/certs"

# -------------------------------------------------------------------
# Docker
# -------------------------------------------------------------------

wazuh_docker_package: docker.io
wazuh_docker_service: docker

wazuh_compose_file: "{{ wazuh_base_dir }}/docker-compose.yml"

wazuh_docker_restart_policy: unless-stopped

# -------------------------------------------------------------------
# Manager
# -------------------------------------------------------------------

wazuh_manager_container_name: wazuh-manager

wazuh_manager_image: "wazuh/wazuh-manager:{{ wazuh_version }}"

wazuh_manager_data_dir: "{{ wazuh_data_dir }}/manager"
wazuh_manager_logs_dir: "{{ wazuh_logs_dir }}/manager"
wazuh_manager_config_dir: "{{ wazuh_config_dir }}/manager"

wazuh_manager_hostname: wazuh-manager

# -------------------------------------------------------------------
# Indexer
# -------------------------------------------------------------------

wazuh_indexer_container_name: wazuh-indexer

wazuh_indexer_image: "wazuh/wazuh-indexer:{{ wazuh_version }}"

wazuh_indexer_data_dir: "{{ wazuh_data_dir }}/indexer"
wazuh_indexer_logs_dir: "{{ wazuh_logs_dir }}/indexer"
wazuh_indexer_config_dir: "{{ wazuh_config_dir }}/indexer"

wazuh_indexer_hostname: wazuh-indexer

wazuh_indexer_port: 9200

# -------------------------------------------------------------------
# Dashboard
# -------------------------------------------------------------------

wazuh_dashboard_container_name: wazuh-dashboard

wazuh_dashboard_image: "wazuh/wazuh-dashboard:{{ wazuh_version }}"

wazuh_dashboard_data_dir: "{{ wazuh_data_dir }}/dashboard"
wazuh_dashboard_logs_dir: "{{ wazuh_logs_dir }}/dashboard"
wazuh_dashboard_config_dir: "{{ wazuh_config_dir }}/dashboard"

wazuh_dashboard_hostname: wazuh-dashboard

wazuh_dashboard_port: 443

# -------------------------------------------------------------------
# Wazuh manager
# -------------------------------------------------------------------

wazuh_manager_address: wazuh-manager

wazuh_manager_port: 1514

wazuh_manager_protocol: tcp

# -------------------------------------------------------------------
# Agent configuration
# -------------------------------------------------------------------

wazuh_agent_groups:
  - default

# -------------------------------------------------------------------
# Logging
# -------------------------------------------------------------------

wazuh_log_level: info

wazuh_log_retention_days: 30

# -------------------------------------------------------------------
# Docker volumes
# -------------------------------------------------------------------

wazuh_persist_manager_data: true
wazuh_persist_manager_logs: true

wazuh_persist_indexer_data: true
wazuh_persist_indexer_logs: true

wazuh_persist_dashboard_data: true
wazuh_persist_dashboard_logs: true

# -------------------------------------------------------------------
# Network
# -------------------------------------------------------------------

wazuh_network_name: wazuh

# -------------------------------------------------------------------
# Services
# -------------------------------------------------------------------

wazuh_enable_manager: true
wazuh_enable_indexer: true
wazuh_enable_dashboard: true

wazuh_service_state: started
wazuh_service_enabled: true
