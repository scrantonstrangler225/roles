---
services:

  wazuh.manager:
    image: "{{ wazuh_manager_image }}"

    hostname: "{{ wazuh_manager_hostname }}"

    container_name: "{{ wazuh_manager_container_name }}"

    restart: "{{ wazuh_restart_policy }}"

    depends_on:
      wazuh.indexer:
        condition: service_healthy

    networks:
      - "{{ wazuh_network_name }}"

    ports:
      - "{{ wazuh_manager_port }}:1514"
      - "{{ wazuh_manager_registration_port }}:1515"
      - "514:514/udp"
      - "{{ wazuh_manager_api_port }}:55000"

    environment:
      WAZUH_INDEXER_HOSTS: "wazuh.indexer:9200"
      WAZUH_NODE_NAME: "manager"
      WAZUH_CLUSTER_NODES: "wazuh.manager"
      WAZUH_CLUSTER_BIND_ADDR: "wazuh.manager"

      INDEXER_USERNAME: "{{ wazuh_manager_indexer_username }}"
      INDEXER_PASSWORD: "{{ wazuh_manager_indexer_password }}"

    ulimits:
      memlock:
        soft: -1
        hard: -1

      nofile:
        soft: 655360
        hard: 655360

    volumes:

      - "{{ wazuh_manager_data_volume }}:/var/wazuh-manager/data"

      - "{{ wazuh_manager_logs_volume }}:/var/wazuh-manager/logs"

      - "{{ wazuh_root_ca_cert }}:/var/wazuh-manager/etc/certs/root-ca.pem:ro"

      - "{{ wazuh_manager_cert }}:/var/wazuh-manager/etc/certs/manager.pem:ro"

      - "{{ wazuh_manager_key }}:/var/wazuh-manager/etc/certs/manager-key.pem:ro"


    healthcheck:
      test:
        - CMD-SHELL
        - >
          /var/wazuh-manager/bin/wazuh-manager-control status
          2>/dev/null |
          grep -q 'not running' &&
          exit 1 ||
          exit 0

      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 60s


  wazuh.indexer:
    image: "{{ wazuh_indexer_image }}"

    hostname: "{{ wazuh_indexer_hostname }}"

    container_name: "{{ wazuh_indexer_container_name }}"

    restart: "{{ wazuh_restart_policy }}"

    networks:
      - "{{ wazuh_network_name }}"

    ports:
      - "{{ wazuh_indexer_port }}:9200"

    environment:
      OPENSEARCH_JAVA_OPTS: "{{ wazuh_indexer_java_opts }}"
      bootstrap.memory_lock: "true"
      network.host: "0.0.0.0"

      node.name: "wazuh.indexer"

      cluster.initial_cluster_manager_nodes: "wazuh.indexer"

      node.max_local_storage_nodes: "1"

      plugins.security.allow_default_init_securityindex: "true"

      NODES_DN: "CN=wazuh.indexer,OU=Wazuh,O=Wazuh,L=California,C=US"
      #DISABLE_INSTALL_DEMO_CONFIG: "true"

    ulimits:
      memlock:
        soft: -1
        hard: -1

      nofile:
        soft: 65536
        hard: 65536

    volumes:

      - "{{ wazuh_indexer_data_volume }}:/var/lib/wazuh-indexer"

      - "{{ wazuh_root_ca_cert }}:/usr/share/wazuh-indexer/config/certs/root-ca.pem:ro"

      - "{{ wazuh_indexer_key }}:/usr/share/wazuh-indexer/config/certs/indexer-key.pem:ro"

      - "{{ wazuh_indexer_cert }}:/usr/share/wazuh-indexer/config/certs/indexer.pem:ro"

      - "{{ wazuh_certs_dir }}/admin.pem:/usr/share/wazuh-indexer/config/certs/admin.pem:ro"

      - "{{ wazuh_certs_dir }}/admin-key.pem:/usr/share/wazuh-indexer/config/certs/admin-key.pem:ro"

      - "{{ wazuh_indexer_opensearch_config }}:/usr/share/wazuh-indexer/config/opensearch.yml:ro"

      #- "{{ wazuh_indexer_security_config }}/internal_users.yml:/usr/share/wazuh-indexer/config/opensearch-security/internal_users.yml:ro"
  
      - "{{ wazuh_indexer_security_config_dir }}/internal_users.yml:/usr/share/wazuh-indexer/config/opensearch-security/internal_users.yml:ro"
      - "{{ wazuh_indexer_security_config_dir }}/config.yml:/usr/share/wazuh-indexer/config/opensearch-security/config.yml:ro"
      - "{{ wazuh_indexer_security_config_dir }}/roles.yml:/usr/share/wazuh-indexer/config/opensearch-security/roles.yml:ro"
      - "{{ wazuh_indexer_security_config_dir }}/roles_mapping.yml:/usr/share/wazuh-indexer/config/opensearch-security/roles_mapping.yml:ro"
      - "{{ wazuh_indexer_security_config_dir }}/action_groups.yml:/usr/share/wazuh-indexer/config/opensearch-security/action_groups.yml:ro"
      - "{{ wazuh_indexer_security_config_dir }}/nodes_dn.yml:/usr/share/wazuh-indexer/config/opensearch-security/nodes_dn.yml:ro"
      - "{{ wazuh_indexer_security_config_dir }}/tenants.yml:/usr/share/wazuh-indexer/config/opensearch-security/tenants.yml:ro"
      - "{{ wazuh_indexer_security_config_dir }}/audit.yml:/usr/share/wazuh-indexer/config/opensearch-security/audit.yml:ro"
      - "{{ wazuh_indexer_security_config_dir }}/allowlist.yml:/usr/share/wazuh-indexer/config/opensearch-security/allowlist.yml:ro"
      - "{{ wazuh_indexer_security_config_dir }}/whitelist.yml:/usr/share/wazuh-indexer/config/opensearch-security/whitelist.yml:ro"


    healthcheck:

      test:
        - CMD-SHELL
        - 'code=$$(curl -ks -o /dev/null -w "%{http_code}" https://localhost:9200/); echo "$$code"; echo "$$code" | grep -Eq "^(200|401|403)$$"'
      timeout: 10s
      interval: 30s
      retries: 10
      start_period: 2m


  wazuh.dashboard:
    image: "{{ wazuh_dashboard_image }}"

    hostname: "{{ wazuh_dashboard_hostname }}"

    container_name: "{{ wazuh_dashboard_container_name }}"

    restart: "{{ wazuh_restart_policy }}"

    depends_on:

      wazuh.indexer:
        condition: service_healthy

      wazuh.manager:
        condition: service_healthy

    networks:
      - "{{ wazuh_network_name }}"

    ports:
      - "{{ wazuh_dashboard_external_port }}:5601"

    environment:

      SERVER_PORT: "5601"

      SERVER_HOST: "0.0.0.0"

      OPENSEARCH_HOSTS: "https://wazuh.indexer:9200"

      WAZUH_API_URL: "https://wazuh.manager"

      DASHBOARD_USERNAME: "{{ wazuh_dashboard_username }}"

      DASHBOARD_PASSWORD: "{{ wazuh_dashboard_password }}"

      SERVER_SSL_CERTIFICATE: "/usr/share/wazuh-dashboard/config/certs/dashboard.pem"

      SERVER_SSL_KEY: "/usr/share/wazuh-dashboard/config/certs/dashboard-key.pem"

      OPENSEARCH_SSL_CERTIFICATE_AUTHORITIES: "/usr/share/wazuh-dashboard/config/certs/root-ca.pem"

    volumes:

      - "{{ wazuh_dashboard_data_volume }}:/usr/share/wazuh-dashboard/data"

      - "{{ wazuh_dashboard_cert }}:/usr/share/wazuh-dashboard/config/certs/dashboard.pem:ro"

      - "{{ wazuh_dashboard_key }}:/usr/share/wazuh-dashboard/config/certs/dashboard-key.pem:ro"

      - "{{ wazuh_root_ca_cert }}:/usr/share/wazuh-dashboard/config/certs/root-ca.pem:ro"

      - "{{ wazuh_dashboard_opensearch_config }}:/usr/share/wazuh-dashboard/config/opensearch_dashboards.yml:ro"


    healthcheck:
      test:
        - CMD
        - curl
        - -k
        - -s
        - -o
        - /dev/null
        - "https://localhost:5601/login"

      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s


networks:

  "{{ wazuh_network_name }}":
    external: true


volumes:

  "{{ wazuh_manager_data_volume }}":
    external: true

  "{{ wazuh_manager_logs_volume }}":
    external: true

  "{{ wazuh_indexer_data_volume }}":
    external: true

  "{{ wazuh_indexer_logs_volume }}":
    external: true

  "{{ wazuh_dashboard_data_volume }}":
    external: true

  "{{ wazuh_manager_etc_volume }}":
    external: true

  "{{ wazuh_manager_queue_volume }}":
    external: true

  "{{ wazuh_manager_multigroups_volume }}":
    external: true

